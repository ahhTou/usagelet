{
  "name": "usagelet",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "本机 AI Agent 用量统计 CLI，支持 Claude Code、Codex、ZCode、DeepSeek Harness，输出与 ccusage 20.0.21 一致，单文件分发",
  "engines": {
    "node": ">=22.16.0"
  },
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:oracle": "npm run build && node scripts/oracle.mjs",
    "test:dsh": "node scripts/dsh-oracle.mjs",
    "compare": "npm run build && node --no-warnings scripts/compare.mjs --bundle",
    "check": "node --check src/index.mjs",
    "format": "prettier --write src scripts test/*.mjs",
    "format:check": "prettier --check src scripts test/*.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "prettier": "3.6.2"
  }
}

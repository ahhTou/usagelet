{
  "name": "usagelet",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "模块化开发、单文件分发的 Agent 用量统计工具",
  "engines": {
    "node": ">=22.16.0"
  },
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:oracle": "npm run build && node scripts/oracle.mjs",
    "check": "node --check src/index.mjs",
    "format": "prettier --write src scripts test/*.mjs",
    "format:check": "prettier --check src scripts test/*.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "prettier": "3.6.2"
  }
}
